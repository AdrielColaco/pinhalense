export interface Manual {
  id: string;
  label: string;
  version: string;
  size: string;
  year: number;
}

export interface Category {
  id: string;
  label: string;
  children: Manual[];
}

export interface Culture {
  id: string;
  label: string;
  image: string;
  caption: string;
  children: Category[];
}

export type CatalogNode =
  | Culture
  | Category
  | Manual
  | { children?: AnyNode[] };

type AnyNode = {
  id?: string;
  label?: string;
  image?: string;
  caption?: string;
  version?: string;
  size?: string;
  year?: number;
  children?: AnyNode[];
};

